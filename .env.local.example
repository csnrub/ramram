# Copy to .env.local and fill in. ./start.sh sources it. Never commit .env.local.

# Encrypted blob-store master key (base64, 32 bytes). Generate one with:
#   python -c "import storage.crypto as c; print(c.generate_master_key())"
export SAMRAM_MASTER_KEY=''

# Kerberos ticket cache the collection engine authenticates with.
export KRB5CCNAME='console.ccache'

# --- optional overrides ------------------------------------------------------
# export SAMRAM_MEMPROCFS='/mnt/c/.../samRAM/bin/memprocfs/MemProcFS.exe'
# export SAMRAM_OROCHI_URL='https://localhost'
